# Public API URL only. Never place Django, database, SMTP, or provider secrets
# in a VITE_* variable: Vite embeds these values in browser-delivered assets.
VITE_API_BASE_URL=https://budgetly.alwaysdata.net/api

# Keep false until founding-user grants and a separately approved rollout.
# Billing pages work for testing while the rest of Budgetly remains accessible.
VITE_ENFORCE_LIFETIME_ACCESS=false

# Public OAuth Web client ID, not a Google client secret.
# Add the same ID to the backend GOOGLE_OAUTH_CLIENT_IDS configuration.
VITE_GOOGLE_CLIENT_ID=
